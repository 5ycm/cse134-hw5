<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="/style.css">
  <script src="/theme.js"></script>
</head>
<body>
  <header>
    <nav>
      <ul>
        <li><a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Home</a></li>
        <li><a href="/projects/"{% if page.url == "/projects/" %} aria-current="page"{% endif %}>Projects</a></li>
      </ul>
    </nav>
    <button type="button" class="theme-toggle" id="theme-toggle" hidden>Switch theme</button>
  </header>
  <main>
{{ content | safe }}
  </main>
  {% include "footer.njk" %}
</body>
</html>
